# ==============================================================================
# MAHMAS LANGUAGE — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION SECRETS TO GIT
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME="Mahmas Language Platform"
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/mahmas_language?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=12

# S3 / Object Storage (Media, Audio, User Uploads)
STORAGE_PROVIDER=s3-compatible
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=mahmas-language-assets
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_FORCE_PATH_STYLE=false

# WebRTC Signaling & STUN/TURN Architecture
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVERS=turn:turn.mahmaslanguage.com:3478
TURN_USERNAME=mahmas_turn_user
TURN_CREDENTIAL=mahmas_turn_secret_password

# AI Provider Configuration (Vendor Agnostic Abstraction Layer)
# Supported adapters: gemini, openai, anthropic, mock
AI_PROVIDER=mock
AI_API_KEY=your_ai_provider_api_key_here
AI_CHAT_MODEL=gemini-1.5-flash
AI_TTS_MODEL=tts-1
AI_STT_MODEL=whisper-1

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Mobile App Public Endpoint Defaults (For client build flavors)
PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
PUBLIC_WS_URL=ws://10.0.2.2:4000
